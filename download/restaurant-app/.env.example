# ── WhatsApp invoice delivery (FREE — Meta WhatsApp Cloud API, no paid tools) ──
# Create a free Meta developer app: https://developers.facebook.com → Create App →
# type "Business" → add the "WhatsApp" product. Copy the values below. Full
# step-by-step guide: docs/WHATSAPP_INVOICE_SETUP.md
#   - The TEST phone number is free forever (max 5 verified recipient numbers).
#   - Invoices are sent as FREE-FORM messages only (never paid templates), so they
#     cost ₹0 whenever the customer has messaged the business number in the last
#     24h — the payment screen's one-tap button does exactly that.
# Leave WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID empty to disable auto-delivery
# (the app then shows view/download + self-save options instead).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The business WhatsApp number customers see/message (digits only, with country code).
# This is what the customer's one-tap opt-in button opens.
WHATSAPP_BUSINESS_NUMBER=
# Any random string — set the same value in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Testing only: override the Graph API base URL (e.g. a local mock). Leave empty in production.
WHATSAPP_API_BASE=
