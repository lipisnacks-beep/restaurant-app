# MongoDB Atlas connection string
# Replace with your own Atlas cluster URI
MONGODB_URI=mongodb+srv://YOUR_ATLAS_USER:YOUR_ATLAS_PASSWORD@cluster0.YOUR_CLUSTER.mongodb.net/restaurant?retryWrites=true&w=majority

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# JWT secret for signing session tokens (use a long random string in production)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-1234567890

# Public base URL of the deployed app (used for QR code links)
# In local dev: http://localhost:3000
# In Vercel: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Google Business review link (the customer is redirected here after eating)
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
